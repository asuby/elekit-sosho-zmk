//スクロール量の調整(デフォルト150)

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

//スクロールの調整

&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

&mkp_input_listener {
    // マウスクリックしてから0.5秒延長
    //input-processors = <&zip_temp_layer 5 500>;
};

&lt {
    tapping-term-ms = <400>;
    quick-tap-ms = <250>;
};

/ {
    behaviors {
        //エンコーダにスクロールを割り当てるためのビヘイビア

        msc_ec_l: sensor_rotation_scroll_L {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        msc_ec_r: sensor_rotation_scroll_R {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    //    combos {
    //        compatible = "zmk,combos";
    //
    //        //左クリックのコンボ 19はJのキー 20はKのキーに相当します。
    //
    //        combo_LCLK {
    //            timeout-ms = <50>;
    //            key-positions = <19 7>;
    //            bindings = <&mkp LCLK>;
    //        };
    //
    //        //右クリックのコンボ 20 K 21 L
    //
    //        combo_RCLK {
    //            timeout-ms = <50>;
    //            key-positions = <21 9>;
    //            bindings = <&mkp RCLK>;
    //        };
    //
    //        //ホイールクリックのコンボ 19 J 21 L
    //
    //        combo_MCLK {
    //            timeout-ms = <90>;
    //            key-positions = <20 8>;
    //            bindings = <&mkp MCLK>;
    //        };
    //    };

    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <10 22>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &lt 3 Q             &kp W           &kp E           &kp R               &kp T        &kp Y            &kp U               &lt 5 I             &kp O                &kp P                   &kp MINUS
&kp TAB       &kp A               &kp S           &kp D           &lt 2 F             &kp G        &kp H            &kp J               &kp K               &kp L                &kp SEMI                &kp COLON
&kp LEFT_ALT  &mt LEFT_CONTROL Z  &mt LEFT_WIN X  &mt LEFT_ALT C  &mt LEFT_CONTROL V  &kp B        &kp N            &mt LEFT_CONTROL M  &mt LEFT_ALT COMMA  &mt LEFT_WIN PERIOD  &mt LEFT_CONTROL SLASH  &kp BACKSLASH
&kp LCTRL     &kp LEFT_WIN                                        &kp LEFT_SHIFT      &lt 1 SPACE  &lt 4 BACKSPACE  &lt 2 ENTER                                                  &kp K_APPLICATION       &kp LGUI
            >;

            //&msc_ec_lとrは、上のビヘイビアで作ったもの。

            sensor-bindings = <&msc_ec_l SCRL_LEFT SCRL_RIGHT &msc_ec_r SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            bindings = <
&trans  &kp NUMBER_6  &kp N7        &kp N8        &kp N9         &kp N0     &none   &kp CARET         &kp NON_US_BACKSLASH  &kp AT_SIGN     &kp N0  &kp DEL
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp N5     &none   &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp UNDERSCORE  &trans  &trans
&trans  &kp SLASH     &kp PERIOD    &kp COMMA     &kp SEMICOLON  &kp COLON  &none   &kp LEFT          &kp LEFT_ALT          &kp RIGHT       &trans  &trans
&trans  &trans                                    &trans         &trans     &trans  &trans                                                  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans               &trans               &trans  &trans &trans  &trans              &kp MINUS       &kp EQUAL            &trans    &trans
&trans  &trans  &kp INTERNATIONAL_5  &kp INTERNATIONAL_4  &trans  &trans &trans  &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &kp HOME  &kp PAGE_UP
&trans  &trans  &trans               &trans               &trans  &trans &trans  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END   &kp PAGE_DOWN
&trans  &trans                                            &trans  &trans &trans  &trans                                                   &trans    &trans
            >;

            //レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &msc_ec_r SCRL_UP SCRL_DOWN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR
&trans  &trans                  &trans  &trans  &trans  &out OUT_BLE                              &trans          &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(LC(TAB))  &kp LC(TAB)        &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans             &trans  &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &trans                                      &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &trans  &mkp LCLK  &trans  &mkp RCLK  &trans  &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &mkp LCLK  &trans  &trans     &trans  &trans
&trans  &trans                     &trans   &trans   &trans  &trans                        &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &mkp RCLK  &trans  &trans
&trans  &trans                  &trans  &trans  &trans  &trans                        &trans  &trans
            >;
        };

        //scroll { status = "reserved"; };
        //extra2 { status = "reserved"; };
    };
};
