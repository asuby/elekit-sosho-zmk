#include "sosho_R.dtsi"

&zip_temp_layer {
	// 下記（J, L）以外のキーを押下でマウスレイヤーを抜ける
    excluded-positions = <
        19
        21
    >;
	// キー入力から0.2秒間はマウスレイヤーに移動しない（誤作動防止）
	require-prior-idle-ms = <200>;
};

&spi1 { status = "okay"; };
&trackball { status = "okay"; };
&trackball_listener {
	status = "okay";
	compatible = "zmk,input-listener";
	device = <&trackball>;

	// マウス操作で0.5秒間マウスレイヤーを有効にする
	input-processors = <
		&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
		&zip_temp_layer 5 500
	>;
};

&glidepoint_split { status = "okay"; };
&glidepoint_split_listener {
    status = "okay";
/* input-processors = <&zip_xy_scaler 2 1>; */
};

&trackball_split { status = "okay"; };
&trackball_split_listener { status = "okay"; };

